{
  "title": "MediFlow — ML Health",
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 38,
  "panels": [
    {
      "title": "Drift score over time by model",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "mediflow_model_drift_score",
          "legendFormat": "{{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.6 }
            ]
          }
        }
      }
    },
    {
      "title": "Anomaly score by model",
      "type": "bargauge",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "mediflow_anomaly_score",
          "legendFormat": "{{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "red", "value": 0.7 }
            ]
          }
        }
      }
    },
    {
      "title": "Current drift score table",
      "type": "table",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "mediflow_model_drift_score",
          "legendFormat": "{{model_name}}",
          "instant": true
        }
      ]
    },
    {
      "title": "Current anomaly score table",
      "type": "table",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "mediflow_anomaly_score",
          "legendFormat": "{{model_name}}",
          "instant": true
        }
      ]
    },
    {
      "title": "STT latency heatmap",
      "type": "heatmap",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "sum by (le)(rate(mediflow_stt_latency_seconds_bucket[5m]))",
          "format": "heatmap"
        }
      ]
    }
  ]
}